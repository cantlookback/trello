<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
    version="3.0">

    <persistence-unit name="trelloPU">

        <class>ru.zinakov.domain.Board</class>
        <class>ru.zinakov.domain.BoardColumn</class>
        <class>ru.zinakov.domain.Card</class>

        <properties>
            <property name="jakarta.persistence.jdbc.url"
                value="jdbc:postgresql://localhost:5432/trello" />
            <property name="jakarta.persistence.jdbc.user" value="trello" />
            <property name="jakarta.persistence.jdbc.password" value="trello" />
            <property name="jakarta.persistence.jdbc.driver"
                value="org.postgresql.Driver" />

            <property name="hibernate.dialect"
                value="org.hibernate.dialect.PostgreSQLDialect" />

            <property name="hibernate.hbm2ddl.auto" value="update" />
            <property name="hibernate.show_sql" value="true" />

        </properties>
    </persistence-unit>
</persistence>